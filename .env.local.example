# Supabase — create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Heartopia daily reset hour in UTC (default: 5 = 8:00 AM Madagascar / Global winter flip)
# Use 10 during US daylight saving if you want strict 6:00 AM Eastern in summer.
SERVER_RESET_HOUR_UTC=5
